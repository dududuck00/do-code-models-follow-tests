{"task_id": "supplement::weighted_list_sums", "description": "Return a weighted sum of two integer lists, using a separate integer weight for each list.", "reference_code": "def donor(a, b, xs, ys):\n    return a * sum(xs) + b * sum(ys)\n", "cases": [{"args": [57, 1, [6, 17, 18, 23, 50], [7, 18, 19, 24, 51]], "output": 6617, "input": "57\n1\n[6, 17, 18, 23, 50]\n[7, 18, 19, 24, 51]", "raw_output": "6617", "mode": "functional", "source_id": "supplement::weighted_list_sums"}, {"args": [65, 2, [5, 46, 54], [6, 47, 55]], "output": 7041, "input": "65\n2\n[5, 46, 54]\n[6, 47, 55]", "raw_output": "7041", "mode": "functional", "source_id": "supplement::weighted_list_sums"}, {"args": [57, 4, [5, 20, 54], [6, 21, 55]], "output": 4831, "input": "57\n4\n[5, 20, 54]\n[6, 21, 55]", "raw_output": "4831", "mode": "functional", "source_id": "supplement::weighted_list_sums"}, {"args": [72, 1, [3, 26, 38, 51, 60], [4, 27, 39, 52, 61]], "output": 12999, "input": "72\n1\n[3, 26, 38, 51, 60]\n[4, 27, 39, 52, 61]", "raw_output": "12999", "mode": "functional", "source_id": "supplement::weighted_list_sums"}, {"args": [64, 1, [10, 28, 30, 48, 53], [11, 29, 31, 49, 54]], "output": 10990, "input": "64\n1\n[10, 28, 30, 48, 53]\n[11, 29, 31, 49, 54]", "raw_output": "10990", "mode": "functional", "source_id": "supplement::weighted_list_sums"}, {"args": [26, 1, [1, 2, 3, 13, 18, 20, 24], [2, 3, 4, 14, 19, 21, 25]], "output": 2194, "input": "26\n1\n[1, 2, 3, 13, 18, 20, 24]\n[2, 3, 4, 14, 19, 21, 25]", "raw_output": "2194", "mode": "functional", "source_id": "supplement::weighted_list_sums"}, {"args": [38, 3, [9, 12, 21, 22, 25, 30, 32], [10, 13, 22, 23, 26, 31, 33]], "output": 6212, "input": "38\n3\n[9, 12, 21, 22, 25, 30, 32]\n[10, 13, 22, 23, 26, 31, 33]", "raw_output": "6212", "mode": "functional", "source_id": "supplement::weighted_list_sums"}, {"args": [52, 3, [39, 40, 47, 49, 50], [40, 41, 48, 50, 51]], "output": 12390, "input": "52\n3\n[39, 40, 47, 49, 50]\n[40, 41, 48, 50, 51]", "raw_outpu