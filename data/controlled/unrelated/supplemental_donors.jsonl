{"task_id": "supplement::count_prefix_in_range", "description": "Count prefix elements whose values lie between two inclusive numeric bounds.", "reference_code": "def donor(values, n, lo, hi):\n    return sum(lo <= x <= hi for x in values[:n])\n", "cases": [{"args": [[-13, -3, -17, -13, 15, 4, -3, -9], 8, -10, -5], "output": 1, "text": "assert donor([-13, -3, -17, -13, 15, 4, -3, -9], 8, -10, -5) == 1", "mode": "function", "source_id": "supplement::count_prefix_in_range", "source_entry": "donor"}, {"args": [[-18, 7, -12, 1, 2, 13, -13, -11, 23, 1, 20, 1], 12, -2, 2], "output": 4, "text": "assert donor([-18, 7, -12, 1, 2, 13, -13, -11, 23, 1, 20, 1], 12, -2, 2) == 4", "mode": "function", "source_id": "supplement::count_prefix_in_range", "source_entry": "donor"}, {"args": [[-23, 21, 1, 22, -21, -8], 6, -5, 5], "output": 1, "text": "assert donor([-23, 21, 1, 22, -21, -8], 6, -5, 5) == 1", "mode": "function", "source_id": "supplement::count_prefix_in_range", "source_entry": "donor"}, {"args": [[-22, -20, -18, -13, -2, -7, 25, 23, -2], 9, -8, -3], "output": 1, "text": "assert donor([-22, -20, -18, -13, -2, -7, 25, 23, -2], 9, -8, -3) == 1", "mode": "function", "source_id": "supplement::count_prefix_in_range", "source_entry": "donor"}, {"args": [[23, 8, -4, 23, -4, -3, -24, -18, -13, -15], 10, -3, 19], "output": 2, "text": "assert donor([23, 8, -4, 23, -4, -3, -24, -18, -13, -15], 10, -3, 19) == 2", "mode": "function", "source_id": "supplement::count_prefix_in_range", "source_entry": "donor"}, {"args": [[-6, 21, -23, 4, -5, 8, 4, -6, 13], 9, 5, 10], "output": 1, "text": "assert donor([-6, 21, -23, 4, -5, 8, 4, -6, 13], 9, 5, 10) == 1", "mode": "function", "source_id": "supplement::count_prefix_in_range", "source_entry": "donor"}, {"args": [[11, 14, 10, 23, 7, 14, 12, 1, -13, -17], 10, -9, 0], "output": 0, "text": "assert donor([11, 14, 10, 23, 7, 14, 12, 1, -13, -17], 10, -9, 0) == 0", "mode": "function", "source_id": "supplement::count_prefix_in_range", "source_entry": "