# Publish only source code, configuration, reproducibility docs and datasets.
/*
!/.gitignore
!/README.md
!/experiment_design.md
!/Makefile
!/environment.yml
!/requirements*.txt
!/src/
!/scripts/
!/tests/
!/configs/
!/data/

# Dataset allowlist: frozen experiments, source benchmarks and tokenizer assets.
/data/*
!/data/controlled/
!/data/model_tokenizers/
!/data/humaneval.jsonl
!/data/humanevalplus.jsonl
!/data/mbpp.jsonl
!/data/mbppplus.jsonl
!/data/livecodebench_release_v6_minus_v5.jsonl.gz
!/data/synthetic_public_tests/

# Keep candidate pools and reports; omit duplicated generated benchmark variants.
/data/synthetic_public_tests/*
!/data/synthetic_public_tests/humanevalplus/
!/data/synthetic_public_tests/mbppplus/
!/data/synthetic_public_tests/livecodebench_v6_new/
/data/synthetic_public_tests/*/*
!/data/synthetic_public_tests/*/synthetic_test_candidates.jsonl
!/data/synthetic_public_tests/*/lcb_synthetic_test_candidates.jsonl
!/data/synthetic_public_tests/*/synthetic_test_report.csv
!/data/synthetic_public_tests/*/lcb_synthetic_test_report.csv

# Local runtimes, caches and generated files (also inside allowed directories).
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/
**/.venv*/
**/venv/
**/.tmp/
**/.codex/
**/.agents/
*.py[cod]
*.egg-info/
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
.DS_Store
Thumbs.db

# Local credentials and model/intermediate tensors.
.env
.env.*
!.env.example
*.pem
*.key
*.safetensors
*.pt
*.pth
*.ckpt
*.npy
*.npz

# FSE review artifact: current manuscript, task-level records and derived analyses.
!/paper/
!/outputs/
/outputs/*
!/outputs/controlled/
!/outputs/analysis/
!/outputs/semantic_representation/
!/outputs/semantic_surface/
!/outputs/semantic_visible/
!/outputs/semantic_cases/
**/states/
!/artifact_manifest.json
!/checksums.sha256
